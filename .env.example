# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_saas?schema=public"

# JWT Secrets
JWT_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"

# Redis Configuration (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Storage Layer Configuration
# Supported options: "local" (for local folder storage) or "s3" (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER="local"
S3_BUCKET="my-ai-saas-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"

# AI Provider Credentials
OPENAI_API_KEY="your-openai-api-key"

